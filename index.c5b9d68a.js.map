"use strict";
var largeImg = document.querySelector("#largeImg");
var galleryList = document.querySelector(".gallery__list");
galleryList.addEventListener("click", function(e) {
    e.preventDefault();
    var link = e.target.closest(".list-item__link");
    if (!link) return;
    var href = link.href;
    largeImg.setAttribute("src", href);
});

